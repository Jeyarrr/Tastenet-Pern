NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tastenet
CLIENT_ORIGIN=http://localhost:5173
# Development also accepts localhost/127.0.0.1 on ports 5173 and 5174.
# Production accepts only CLIENT_ORIGIN.
SESSION_DAYS=7
SESSION_COOKIE_NAME=tastenet_session
# Optional email verification and password reset. Keep real credentials in .env.
EMAIL_VERIFICATION_REQUIRED=false
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=TasteNet <noreply@example.com>
# Google Cloud must allow this exact callback URI.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
